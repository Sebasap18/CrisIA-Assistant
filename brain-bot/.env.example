# ============================================================
#  OmniMind Brain-Bot — Variables de Entorno
#  Copia este archivo a .env y completa los valores reales.
#  NUNCA subas .env al repositorio (ya está en .gitignore).
# ============================================================

# --- PostgreSQL ---
# Formato: postgresql://usuario:contraseña@servidor:puerto/base_de_datos
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/omnimind_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Ollama (servidor LLM local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60.0
OLLAMA_CLASSIFIER_TIMEOUT=10.0
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- ChromaDB (vectorstore RAG) ---
CHROMA_PATH=./chroma_db
RAG_TOP_K=3

# --- Historial de chat ---
# Cantidad máxima de mensajes a recuperar por sesión
HISTORY_MAX_TURNS=6

# --- Ingesta de documentos ---
# CLIENT_ID por defecto al ejecutar: python -m app.scripts.ingest
INGEST_CLIENT_ID=accesspark_001
